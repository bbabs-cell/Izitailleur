# pnpm bloque par défaut l'installation de paquets publiés trop récemment (protection contre les
# paquets malveillants tout juste publiés). Ce projet installe régulièrement des dépendances très
# récentes (SDK Vercel, Expo, AWS) au moment même de leur sortie, ce qui déclenchait cette
# politique aussi bien en local (Windows) que sur les serveurs de build EAS Build — désactivée ici
# pour que tous les environnements du projet se comportent de la même façon, sans contournement
# manuel répété à chaque installation.
minimum-release-age=0
