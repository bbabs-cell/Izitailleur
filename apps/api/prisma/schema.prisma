generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  TAILOR
  CUTTER
  APPRENTICE
  FINISHER
  DELIVERY
}

model Workshop {
  id            String    @id @default(uuid())
  name          String
  phone         String?
  address       String?
  orderSequence Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  users        User[]
  customers    Customer[]
  orders       Order[]
  appointments Appointment[]
  suppliers    Supplier[]
  fabrics      Fabric[]
  issues       WorkshopIssue[]
}

model User {
  id               String    @id @default(uuid())
  workshopId       String
  workshop         Workshop  @relation(fields: [workshopId], references: [id])
  fullName         String
  phone            String    @unique
  passwordHash     String
  role             Role
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  assignedOrders Order[]         @relation("OrderAssignee")
  assignedTasks  OrderTask[]     @relation("TaskAssignee")
  assignedIssues WorkshopIssue[] @relation("IssueAssignee")

  @@index([workshopId])
}

model Customer {
  id         String    @id @default(uuid())
  workshopId String
  workshop   Workshop  @relation(fields: [workshopId], references: [id])
  firstName  String
  lastName   String
  phone      String?
  whatsapp   String?
  address    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  measurementProfiles MeasurementProfile[]
  orders              Order[]
  appointments        Appointment[]

  @@index([workshopId])
  @@index([workshopId, phone])
}

model MeasurementProfile {
  id         String    @id @default(uuid())
  workshopId String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  label      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  measurements Measurement[]
  orders       Order[]

  @@index([customerId])
  @@index([workshopId])
}

model Measurement {
  id         String             @id @default(uuid())
  profileId  String
  profile    MeasurementProfile @relation(fields: [profileId], references: [id])
  values     Json
  recordedAt DateTime           @default(now())

  @@index([profileId])
}

enum OrderStatus {
  NEW
  PENDING
  CUTTING
  SEWING
  FITTING
  ALTERATION
  FINISHING
  READY
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Order {
  id                   String              @id @default(uuid())
  workshopId           String
  workshop             Workshop            @relation(fields: [workshopId], references: [id])
  reference            String
  customerId           String
  customer             Customer            @relation(fields: [customerId], references: [id])
  measurementProfileId String?
  measurementProfile   MeasurementProfile? @relation(fields: [measurementProfileId], references: [id])
  modelName            String
  fabricDescription    String?
  fabricId             String?
  fabric               Fabric?             @relation(fields: [fabricId], references: [id])
  fabricQuantity       Float?
  quantity             Int                 @default(1)
  price                Int
  deposit              Int                 @default(0)
  orderDate            DateTime            @default(now())
  dueDate              DateTime
  deliveredAt          DateTime?
  priority             Priority            @default(NORMAL)
  status               OrderStatus         @default(NEW)
  assignedToId         String?
  assignedTo           User?               @relation("OrderAssignee", fields: [assignedToId], references: [id])
  instructions         String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  images        OrderImage[]
  tasks         OrderTask[]
  statusHistory OrderStatusChange[]
  appointments  Appointment[]
  issues        WorkshopIssue[]

  @@unique([workshopId, reference])
  @@index([workshopId])
  @@index([workshopId, status])
}

model OrderStatusChange {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedAt  DateTime     @default(now())

  @@index([orderId])
}

model OrderImage {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  url       String
  createdAt DateTime @default(now())

  @@index([orderId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model OrderTask {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id])
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([orderId])
  @@index([assignedToId])
}

enum AppointmentType {
  FITTING
  DELIVERY
  PICKUP
  PAYMENT
  TASK
  OTHER
}

model Appointment {
  id         String          @id @default(uuid())
  workshopId String
  workshop   Workshop        @relation(fields: [workshopId], references: [id])
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?          @relation(fields: [orderId], references: [id])
  type       AppointmentType
  title      String
  startAt    DateTime
  endAt      DateTime?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  @@index([workshopId, startAt])
}

model Supplier {
  id         String    @id @default(uuid())
  workshopId String
  workshop   Workshop  @relation(fields: [workshopId], references: [id])
  name       String
  phone      String?
  whatsapp   String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  fabrics Fabric[]

  @@index([workshopId])
}

model Fabric {
  id            String    @id @default(uuid())
  workshopId    String
  workshop      Workshop  @relation(fields: [workshopId], references: [id])
  name          String
  reference     String?
  color         String?
  quantity      Float     @default(0)
  unit          String    @default("m")
  purchasePrice Int?
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  location      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  movements FabricMovement[]
  orders    Order[]

  @@index([workshopId])
}

enum FabricMovementType {
  IN
  OUT
  ADJUSTMENT
}

model FabricMovement {
  id        String             @id @default(uuid())
  fabricId  String
  fabric    Fabric             @relation(fields: [fabricId], references: [id])
  type      FabricMovementType
  quantity  Float
  orderId   String?
  note      String?
  createdAt DateTime           @default(now())

  @@index([fabricId])
}

enum IssueCategory {
  BAD_MEASUREMENT
  INSUFFICIENT_FABRIC
  DEFECTIVE_FABRIC
  BAD_CUT
  ALTERATION
  DELAY
  CUSTOMER_ABSENT
  MODEL_CHANGE
  MACHINE_BREAKDOWN
  APPRENTICE_LATE
  SUPPLIER_LATE
  PAYMENT
  DELIVERY
  OTHER
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model WorkshopIssue {
  id           String        @id @default(uuid())
  workshopId   String
  workshop     Workshop      @relation(fields: [workshopId], references: [id])
  title        String
  description  String?
  category     IssueCategory
  priority     Priority      @default(NORMAL)
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  assignedToId String?
  assignedTo   User?         @relation("IssueAssignee", fields: [assignedToId], references: [id])
  photoUrl     String?
  status       IssueStatus   @default(OPEN)
  solution     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  resolvedAt   DateTime?

  @@index([workshopId])
  @@index([workshopId, status])
}
