# Base de données (développement local : Postgres local. Production : chaîne poolée Neon,
# suffixe "-pooler" — voir docs/DEPLOYMENT.md).
DATABASE_URL="postgresql://izitailleur:izitailleur@localhost:5432/izitailleur?schema=public"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

PORT=3000

# Anti-brute-force partagé (obligatoire en production serverless — voir ARCHITECTURE.md).
# Laisser vide en développement local : le limiteur utilise alors la mémoire locale.
REDIS_URL=""

# Stockage des photos de commandes (Cloudflare R2, compatible S3). Laisser vide pour désactiver
# la fonctionnalité (elle échoue alors explicitement avec un 503, sans rien simuler).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
