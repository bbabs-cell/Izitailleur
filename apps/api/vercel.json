{
  "version": 2,
  "buildCommand": "cd ../.. && pnpm build:shared && pnpm --filter @izitailleur/api run prisma:generate",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
